+#define SHADOW_STRIKE_BUFF MAKEFOURCC('B','E','s','h')
+#define SHADOW_STRIKE_TICK_MS 1000
+
+static heroabilitystatus_t *shadow_strike_status(edict_t const *unit) {
+    heroabilitystatus_t *slot = unit ? unit_findstatus((edict_t *)unit, SHADOW_STRIKE_BUFF) : NULL;
+    return slot && slot->data && (slot->data == MAKEFOURCC('A','E','s','h') ||
+                                  slot->data == MAKEFOURCC('A','C','s','s')) ? slot : NULL;
+}
+
+static bool shadow_strike_slow_active(heroabilitystatus_t const *slot) {
+    uint32_t start, slow_ms;
+    if (!slot || !slot->level || !slot->data || !slot->duration_ms ||
+        slot->timestamp <= G_Time() || slot->timestamp < slot->duration_ms) return false;
+    start = slot->timestamp - slot->duration_ms;
+    slow_ms = (uint32_t)(MAX(0.0f, S_SpellData(slot->data, slot->rank, 4)) * 1000.0f);
+    return slow_ms && G_Time() < start + slow_ms;
+}
+
+float S_ShadowStrikeMoveReduction(edict_t const *unit) {
+    heroabilitystatus_t const *slot = shadow_strike_status(unit);
+    return shadow_strike_slow_active(slot) ?
+        MAX(0.0f, MIN(0.9f, S_SpellData(slot->data, slot->rank, 2))) : 0.0f;
+}
+
+float S_ShadowStrikeAttackReduction(edict_t const *unit) {
+    heroabilitystatus_t const *slot = shadow_strike_status(unit);
+    return shadow_strike_slow_active(slot) ?
+        MAX(0.0f, MIN(0.9f, S_SpellData(slot->data, slot->rank, 3))) : 0.0f;
+}
+
+static void shadow_strike_tick(edict_t *target, heroabilitystatus_t *slot) {
+    edict_t *source = S_SpellStatusSource(slot);
+    float damage;
+    if (!source) { unit_expirestatus(target, slot); return; }
+    damage = MAX(0.0f, S_SpellData(slot->data, slot->rank, 1));
+    /* TODO(UNVERIFIED): retail JASS timing has not established the exact
+     * poison pulse phase/cadence; DataA is treated as DPS at one-second ticks. */
+    while (slot->level && slot->next_tick <= G_Time() && slot->next_tick < slot->timestamp) {
+        slot->next_tick += SHADOW_STRIKE_TICK_MS;
+        if (damage > 0.0f) S_SpellDamage(target, source, (int)damage);
+        if (M_IsDead(target)) break;
+    }
+}

-    S_SpellDamage(target, caster, damage);
-    /* TODO(1:1): Shadow Strike also applies a movement slow and a decaying
-     * poison DoT via the BEsh buff.  The status system needs a movement-speed
-     * modifier and a periodic-damage tick first. */
+BZ_ABILITY_PROC(CAbilityShadowStrike) {
+    if (msg == A_STATUS_TICK && call && call->status.slot) {
+        shadow_strike_tick(ent, call->status.slot);
+        return true;
+    }
+    if (msg == A_STATUS_DEATH && call && call->status.slot) {
+        unit_expirestatus(ent, call->status.slot);
+        return true;
+    }
+    if (msg == A_EXECUTE) {
+        spellTarget_t target = call && call->target ? *call->target : MAKE(spellTarget_t, .type = SPELL_TARGET_NONE);
+        abilityitem_t const *spell = call ? call->item : NULL;
+        uint32_t level;
+        float duration;
+        heroabilitystatus_t *slot;
+        if (!spell || !target.entity) return true;
+        level = S_SpellLevel(ent, spell->code);
+        S_SpellDamage(target.entity, ent, (int)MAX(1.0f, S_SpellData(spell->code, level, 5)));
+        if (M_IsDead(target.entity)) return true;
+        duration = S_SpellResistantDuration(spell->code, level, target.entity);
+        slot = S_SpellApplyTimedTargetStatus(target.entity, spell->code, level, "BEsh", duration);
+        if (slot) {
+            slot->data = spell->code;
+            slot->rank = level;
+            slot->source = ent;
+            slot->source_spawn_time = ent->spawn_time;
+            slot->next_tick = G_Time() + SHADOW_STRIKE_TICK_MS;
+        }
+        return true;
+    }
+    return CAbilitySimpleSpell(ent, msg, call);
 }
