+static bool faerie_status_owned(heroabilitystatus_t const *slot) {
+    abilityitem_t item;
+    if (!slot || !slot->data) return false;
+    item = S_AbilityItem(slot->data);
+    return item.ability && item.ability->proc == CAbilityFaerieFire;
+}
+
+static void faerie_reveal_remove(edict_t *target, heroabilitystatus_t *slot) {
+    if (!target || !slot || !faerie_status_owned(slot)) return;
+    /* Faerie Fire has no periodic payload. Keep its viewer in rank so expiry
+     * can release the right contribution even if the caster edict was freed
+     * and reused before this target's status expired. */
+    if (slot->rank < MAX_PLAYERS) G_RemoveUnitForcedVisibility(target, slot->rank);
+}
+
+static void faerie_fire_execute(edict_t *caster, spellTarget_t st, abilityitem_t const *spell) {
+    uint32_t level = S_SpellLevel(caster, spell->code);
+    cstring_t buff = melee_buff(spell, level);
+    heroabilitystatus_t *old, *slot;
+    uint32_t buff_code, viewer, old_viewer = MAX_PLAYERS;
+    bool had_reveal;
+    if (!st.entity || !buff || !caster || caster->s.player >= MAX_PLAYERS) return;
+    buff_code = FS_SLKKey(buff);
+    viewer = caster->s.player;
+    old = unit_findstatus(st.entity, buff_code);
+    had_reveal = faerie_status_owned(old) && old->rank < MAX_PLAYERS;
+    if (had_reveal) old_viewer = old->rank;
+    slot = S_SpellApplyTimedTargetStatus(st.entity, spell->code, level, buff,
+                                         S_SpellHeroDuration(spell->code, level, st.entity));
+    if (!slot) return;
+    /* unit_addtimedstatus replaces the payload in place without sending the
+     * old status's remove callback, so transfer its owned reveal explicitly. */
+    if (had_reveal) G_RemoveUnitForcedVisibility(st.entity, old_viewer);
+    G_AddUnitForcedVisibility(st.entity, viewer);
+    slot->data = spell->code;
+    slot->source = caster;
+    slot->source_spawn_time = caster->spawn_time;
+    slot->rank = viewer;
+}
